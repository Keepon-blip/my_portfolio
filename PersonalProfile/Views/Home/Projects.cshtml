@{
    ViewData["Title"] = "Projects";
}

<div class="container py-5">
    <h1 class="display-4 fw-bold text-primary mb-5">My Ventures & Projects</h1>

    <div class="row g-5">
        <div class="col-lg-12">
            <div class="card overflow-hidden">
                <div class="row g-0">
                    <div class="col-md-6">
                        <div id="amanahCarousel" class="carousel slide" data-bs-ride="carousel">
                            <div class="carousel-inner">
                                <div class="carousel-item active">
                                    <img src="~/images/projects/amanahlogistics.png" class="d-block w-100" alt="Amanah Dashboard">
                                </div>
                                <div class="carousel-item">
                                    <img src="~/images/projects/dashboard.png" class="d-block w-100" alt="Order Tracking">
                                </div>
                                <div class="carousel-item">
                                    <img src="~/images/projects/createorder.png" class="d-block w-100" alt="Admin Panel">
                                </div>
                            </div>
                            <button class="carousel-control-prev" type="button" data-bs-target="#amanahCarousel" data-bs-slide="prev">
                                <span class="carousel-control-prev-icon" aria-hidden="true"></span>
                                <span class="visually-hidden">Previous</span>
                            </button>
                            <button class="carousel-control-next" type="button" data-bs-target="#amanahCarousel" data-bs-slide="next">
                                <span class="carousel-control-next-icon" aria-hidden="true"></span>
                                <span class="visually-hidden">Next</span>
                            </button>
                        </div>
                    </div>
                    <div class="col-md-6">
                        <div class="card-body p-5 d-flex flex-column justify-content-center h-100">
                            <h3 class="card-title fw-bold text-primary mb-3">Amanah Logistics</h3>
                            <span class="badge bg-success w-auto align-self-start mb-3">Startup</span>
                            <p class="card-text lead">
                                A comprehensive delivery management platform designed to streamline logistics. 
                                Features real-time tracking, automated dispatching, and a robust admin dashboard.
                            </p>
                            <div class="mt-auto">
                                <a href="https://amanahlogistics.com/" class="btn btn-primary me-2">Visit Website</a>
                            </div>
                        </div>
                    </div>
                </div>
            </div>
        </div>

        <div class="col-md-6">
            <div class="card h-100">
                <!-- Carousel for Rider App -->
                <div id="riderCarousel" class="carousel slide" data-bs-ride="carousel">
                    <div class="carousel-inner bg-dark text-center">
                        <div class="carousel-item active">
                            <img src="~/images/projects/flutter app 1.jpg" class="d-block mx-auto" style="height: 500px; object-fit: contain;" alt="Rider App Screen 1">
                        </div>
                        <div class="carousel-item">
                            <img src="~/images/projects/flutter app 2.jpg" class="d-block mx-auto" style="height: 500px; object-fit: contain;" alt="Rider App Screen 2">
                        </div>
                        <div class="carousel-item">
                            <img src="~/images/projects/flutter app 4.jpg" class="d-block mx-auto" style="height: 500px; object-fit: contain;" alt="Rider App Screen 3">
                        </div>
                        <div class="carousel-item">
                            <img src="~/images/projects/flutter app 3.jpg" class="d-block mx-auto" style="height: 500px; object-fit: contain;" alt="Rider App Screen 3">
                        </div>
                    </div>
                    <button class="carousel-control-prev" type="button" data-bs-target="#riderCarousel" data-bs-slide="prev">
                        <span class="carousel-control-prev-icon" aria-hidden="true"></span>
                        <span class="visually-hidden">Previous</span>
                    </button>
                    <button class="carousel-control-next" type="button" data-bs-target="#riderCarousel" data-bs-slide="next">
                        <span class="carousel-control-next-icon" aria-hidden="true"></span>
                        <span class="visually-hidden">Next</span>
                    </button>
                </div>
                
                <div class="card-body p-4">
                    <h4 class="card-title fw-bold text-info">Amanah Rider's App</h4>
                    <p class="card-text mt-3">
                        The rider mobile application for Amanah's riders. Built with <strong>Flutter</strong>, 
                        it handles order acceptance, navigation, and earnings tracking in real-time.
                    </p>
                    <div class="d-flex gap-2 mt-3">
                        <span class="badge bg-secondary">Flutter</span>
                        <span class="badge bg-secondary">Dart</span>
                    </div>
                </div>
            </div>
        </div>

        <div class="col-md-6">
            <div class="card h-100">
                <div id="freewillCarousel" class="carousel slide" data-bs-ride="carousel">
                    <div class="carousel-inner bg-dark text-center">
                        <div class="carousel-item active">
                            <img src="~/images/projects/freewill1.jpg" class="d-block mx-auto" style="height: 500px; object-fit: contain;" alt="Freewill Collection 1">
                        </div>
                        <div class="carousel-item">
                            <img src="~/images/projects/freewill2.jpg" class="d-block mx-auto" style="height: 500px; object-fit: contain;" alt="Freewill Collection 2">
                        </div>
                        <div class="carousel-item">
                            <img src="~/images/projects/freewill3.jpg" class="d-block mx-auto" style="height: 500px; object-fit: contain;" alt="Freewill Collection 3">
                        </div>
                        <div class="carousel-item">
                            <img src="~/images/projects/freewill4.jpg" class="d-block mx-auto" style="height: 500px; object-fit: contain;" alt="Freewill Collection 4">
                        </div>
                        <div class="carousel-item">
                            <img src="~/images/projects/freewill5.jpg" class="d-block mx-auto" style="height: 500px; object-fit: contain;" alt="Freewill Collection 5">
                        </div>
                        <div class="carousel-item">
                            <img src="~/images/projects/freewill6.jpg" class="d-block mx-auto" style="height: 500px; object-fit: contain;" alt="Freewill Collection 6">
                        </div>
                        <div class="carousel-item">
                            <img src="~/images/projects/freewill7.jpg" class="d-block mx-auto" style="height: 500px; object-fit: contain;" alt="Freewill Collection 7">
                        </div>
                    </div>
                    <button class="carousel-control-prev" type="button" data-bs-target="#freewillCarousel" data-bs-slide="prev">
                        <span class="carousel-control-prev-icon" aria-hidden="true"></span>
                        <span class="visually-hidden">Previous</span>
                    </button>
                    <button class="carousel-control-next" type="button" data-bs-target="#freewillCarousel" data-bs-slide="next">
                        <span class="carousel-control-next-icon" aria-hidden="true"></span>
                        <span class="visually-hidden">Next</span>
                    </button>
                </div>

                <div class="card-body p-4">
                    <h4 class="card-title fw-bold text-warning">Freewill Collection</h4>
                    <p class="card-text mt-3">
                        My personal clothing brand. in collaboration with two of my friends, focusing on unique designs and quality materials. 
                        I handle brand identity and graphic design, while my friends handle marketing and sales.
                    </p>
                    <div class="d-flex gap-2 mt-3">
                        <span class="badge bg-secondary">Clothing brand</span>
                        <span class="badge bg-secondary">E-commerce</span>
                    </div>
                </div>
            </div>
        </div>
    </div>
</div>
