@{
    ViewData["Title"] = "Privacy Notice | Keepon Mirishoi Ole Supuko";
    ViewData["Description"] = "Privacy notice for the portfolio of Keepon Mirishoi Ole Supuko, including hosting logs, external contact services, cookies, and information handling.";
    ViewData["CanonicalPath"] = "/privacy";
}

<div class="container py-5 fade-in-on-scroll">
    <div class="mx-auto" style="max-width: 820px;">
        <header class="mb-4">
            <span class="text-uppercase text-muted small font-monospace">Your privacy</span>
            <h1 class="display-5 text-primary mt-2 mb-3">Privacy Notice</h1>
            <p class="lead text-muted mb-0">
                This notice explains how this portfolio handles information when you visit the website or contact me.
            </p>
        </header>

        <article class="card p-4 p-md-5">
            <section class="mb-4">
                <h2 class="h4 text-white">Information collected by this website</h2>
                <p class="text-muted mb-0">
                    This portfolio does not include user accounts, a database-backed contact form, advertising,
                    analytics trackers, or intentionally set tracking cookies. It does not directly collect or store
                    personal information submitted by visitors.
                </p>
            </section>

            <section class="mb-4">
                <h2 class="h4 text-white">Hosting and technical logs</h2>
                <p class="text-muted mb-0">
                    The website is hosted using Render. Like most hosting providers, Render may process basic technical
                    information such as IP addresses, browser details, request times, and error logs to operate and
                    secure the service. That processing is governed by Render's own privacy practices.
                </p>
            </section>

            <section class="mb-4">
                <h2 class="h4 text-white">Contact and external services</h2>
                <p class="text-muted mb-0">
                    Contact buttons open third-party services such as email, LinkedIn, and GitHub. Information you send
                    through those services is handled according to their respective privacy policies. This website does
                    not claim that a message has been submitted merely because you selected one of those links.
                </p>
            </section>

            <section class="mb-4">
                <h2 class="h4 text-white">Changes to this notice</h2>
                <p class="text-muted mb-0">
                    This notice may be updated if the website later adds analytics, cookies, account features, or other
                    ways of collecting information.
                </p>
            </section>

            <section>
                <h2 class="h4 text-white">Privacy questions</h2>
                <p class="text-muted">
                    For questions about this notice, email
                    <a href="mailto:skmephep@gmail.com">skmephep@gmail.com</a>.
                </p>
                <p class="small text-muted mb-0">Last updated: 16 July 2026</p>
            </section>
        </article>
    </div>
</div>
