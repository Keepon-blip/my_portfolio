@{
    ViewData["Title"] = "About Me";
}

<div class="container py-5 fade-in-on-scroll">
    <!-- Row 1: Who I Am & Profile Image -->
    <div class="row align-items-center mb-5 min-vh-75">
        <div class="col-lg-7 mb-5 mb-lg-0">
            <div class="pe-lg-5">
                <h1 class="display-1 fw-bold text-white mb-4">About<br><span class="text-primary">Me.</span></h1>
                <h3 class="section-title mb-3">Who I Am</h3>
                <p class="lead text-muted mb-4" style="max-width: 600px;">
                    I am a 4th-year Software Engineering student at <strong>Xiamen University Malaysia</strong>, specializing in creating high-quality, scalable digital solutions.
                </p>
                <p class="text-muted mb-4" style="max-width: 600px;">
                    Over the course of my academic and entrepreneurial career, I have developed professional experience in <strong>Full Stack Development</strong>, <strong>Mobile Applications</strong>, <strong>Cloud Deployment</strong>, <strong>Startup Product Development</strong>, and <strong>Unity 3D Engine Development</strong>.
                </p>
                <p class="text-muted mb-4" style="max-width: 600px;">
                    I believe in engineering clean, maintainable systems that solve practical challenges. As a co-founder of a logistics startup, I understand the intersection of business strategy, backend architecture, and user experience.
                </p>
                <div class="mt-4">
                    <a href="/files/Keepon_Mirishoi_Resume.pdf" download="Keepon_Mirishoi_Resume.pdf" class="btn btn-primary btn-lg d-inline-flex align-items-center gap-2">
                        <i class="bi bi-download"></i> Download Resume
                    </a>
                </div>
            </div>
        </div>
        <div class="col-lg-5">
            <div class="profile-frame mx-auto">
                <img src="~/images/profile.jpeg" alt="Keepon Mirishoi" class="img-fluid">
            </div>
        </div>
    </div>

    <!-- Row 2: Education & Experience Timeline -->
    <div class="row mb-5">
        <!-- Education -->
        <div class="col-lg-5 mb-5 mb-lg-0">
            <div class="card p-4 h-100">
                <h3 class="mb-4 text-primary"><i class="bi bi-mortarboard-fill"></i> Education</h3>
                
                <div class="mb-4">
                    <h5 class="fw-bold mb-1">Bachelor of Software Engineering</h5>
                    <p class="text-muted mb-1">Xiamen University Malaysia</p>
                    <small class="text-primary font-monospace">2023 - 2027 (Expected)</small>
                </div>
                
                <hr class="border-secondary my-3">
                
                <div class="mb-4">
                    <h5 class="fw-bold mb-1">Software Development Certificate</h5>
                    <p class="text-muted mb-1">Zalego Institute, Kenya</p>
                    <small class="text-primary font-monospace">2022</small>
                </div>
                
                <hr class="border-secondary my-3">
                
                <div>
                    <h5 class="fw-bold mb-1">Secondary Education</h5>
                    <p class="text-muted mb-1">Mang'u High School, Kenya</p>
                    <small class="text-primary font-monospace">2018 - 2022</small>
                </div>
            </div>
        </div>

        <!-- Experience Timeline -->
        <div class="col-lg-7">
            <div class="card p-4 h-100">
                <h3 class="mb-4 text-primary"><i class="bi bi-briefcase-fill"></i> Experience</h3>
                
                <div class="timeline">
                    <!-- Amanah Logistics -->
                    <div class="timeline-item mb-4">
                        <div class="d-flex flex-wrap justify-content-between align-items-start mb-2">
                            <div>
                                <h5 class="fw-bold mb-0 text-white">Co-Founder & Developer</h5>
                                <small class="text-muted">Amanah Logistics</small>
                            </div>
                            <span class="badge bg-primary">2024 - Present</span>
                        </div>
                        <ul class="text-muted ps-3 small mb-0">
                            <li>Architected and developed the rider mobile application in Flutter/Dart.</li>
                            <li>Engineered the backend services using Node.js, Express, and Supabase.</li>
                            <li>Collaborated on core business strategies, product roadmaps, and logistics UI/UX.</li>
                        </ul>
                    </div>

                    <hr class="border-secondary my-3">

                    <!-- Freewill Clothing -->
                    <div class="timeline-item mb-4">
                        <div class="d-flex flex-wrap justify-content-between align-items-start mb-2">
                            <div>
                                <h5 class="fw-bold mb-0 text-white">Founder</h5>
                                <small class="text-muted">Freewill Clothing</small>
                            </div>
                            <span class="badge bg-warning text-dark">2023 - Present</span>
                        </div>
                        <ul class="text-muted ps-3 small mb-0">
                            <li>Designed and launched a custom brand identity, apparel catalog, and media assets.</li>
                            <li>Built the custom e-commerce system featuring shopping cart and checkout integrations.</li>
                            <li>Implemented the database structure and admin tracking panel using ASP.NET Core & SQL Server.</li>
                        </ul>
                    </div>

                    <hr class="border-secondary my-3">

                    <!-- BioScope FYP -->
                    <div class="timeline-item">
                        <div class="d-flex flex-wrap justify-content-between align-items-start mb-2">
                            <div>
                                <h5 class="fw-bold mb-0 text-white">Final Year Project Developer</h5>
                                <small class="text-muted">BioScope</small>
                            </div>
                            <span class="badge bg-info text-dark">Academic Project</span>
                        </div>
                        <ul class="text-muted ps-3 small mb-0">
                            <li>Programmed game logic, physics interactions, and core mechanics using Unity & C#.</li>
                            <li>Created custom environment layouts and lighting using Unity's URP pipelines.</li>
                            <li>Optimized user experiences, game interfaces, and rendering behaviors.</li>
                        </ul>
                    </div>
                </div>
            </div>
        </div>
    </div>

