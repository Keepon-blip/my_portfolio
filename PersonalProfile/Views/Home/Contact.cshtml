@{
    ViewData["Title"] = "Contact";
}

<div class="container py-5 fade-in-on-scroll">
    <h1 class="display-4 fw-bold text-primary mb-5">Let's Connect</h1>

    <div class="row g-4">
        <!-- Recruiter Info Column -->
        <div class="col-lg-5 mb-4">
            <div class="card p-4 h-100 d-flex flex-column justify-content-between">
                <div>
                    <h3 class="fw-bold mb-3 text-white">Recruiter Information</h3>
                    <p class="text-muted mb-4">
                        Interested in working together, discussing opportunities, or collaborating on a software project? Reach out through any of the channels below.
                    </p>

                    <!-- Location -->
                    <div class="d-flex align-items-center mb-4">
                        <div class="fs-3 text-primary me-3">
                            <i class="bi bi-geo-alt-fill"></i>
                        </div>
                        <div>
                            <h6 class="mb-0 text-muted small">Location</h6>
                            <p class="mb-0 text-white fw-bold">Kuala Lumpur, Malaysia</p>
                        </div>
                    </div>

                    <!-- Outlook Email -->
                    <div class="d-flex align-items-center mb-4">
                        <div class="fs-3 text-primary me-3">
                            <i class="bi bi-envelope-at-fill"></i>
                        </div>
                        <div>
                            <h6 class="mb-0 text-muted small">Academic / Outlook Email</h6>
                            <a href="mailto:SWE2302209@xmu.edu.my" class="text-light text-decoration-none fw-bold">SWE2302209@xmu.edu.my</a>
                        </div>
                    </div>

                    <!-- Personal Email -->
                    <div class="d-flex align-items-center mb-4">
                        <div class="fs-3 text-primary me-3">
                            <i class="bi bi-envelope-fill"></i>
                        </div>
                        <div>
                            <h6 class="mb-0 text-muted small">Personal / Gmail</h6>
                            <a href="mailto:skmephep@gmail.com" class="text-light text-decoration-none fw-bold">skmephep@gmail.com</a>
                        </div>
                    </div>

                    <!-- GitHub -->
                    <div class="d-flex align-items-center mb-4">
                        <div class="fs-3 text-primary me-3">
                            <i class="bi bi-github"></i>
                        </div>
                        <div>
                            <h6 class="mb-0 text-muted small">GitHub</h6>
                            <a href="https://github.com/Keepon-blip" target="_blank" rel="noopener noreferrer" class="text-light text-decoration-none fw-bold">github.com/Keepon-blip</a>
                        </div>
                    </div>

                    <!-- LinkedIn -->
                    <div class="d-flex align-items-center mb-4">
                        <div class="fs-3 text-primary me-3">
                            <i class="bi bi-linkedin"></i>
                        </div>
                        <div>
                            <h6 class="mb-0 text-muted small">LinkedIn</h6>
                            <a href="https://linkedin.com/in/keepon-mirishoi" target="_blank" rel="noopener noreferrer" class="text-light text-decoration-none fw-bold">linkedin.com/in/keepon-mirishoi</a>
                        </div>
                    </div>
                </div>

                <div class="border-top border-secondary pt-3 mt-4">
                    <p class="small text-muted mb-0">Typical response time: Under 24 hours.</p>
                </div>
            </div>
        </div>

        <!-- Contact Form Column -->
        <div class="col-lg-7 mb-4">
            <div class="card p-4 h-100">
                <h3 class="fw-bold mb-4 text-white">Send a Message</h3>
                <form>
                    <div class="mb-3">
                        <label class="form-label text-muted small">Name</label>
                        <input type="text" class="form-control bg-dark text-light border-secondary p-3" placeholder="Your Name" style="border-radius: 12px; background: rgba(0,0,0,0.3) !important;">
                    </div>
                    <div class="mb-3">
                        <label class="form-label text-muted small">Email Address</label>
                        <input type="email" class="form-control bg-dark text-light border-secondary p-3" placeholder="Your Email" style="border-radius: 12px; background: rgba(0,0,0,0.3) !important;">
                    </div>
                    <div class="mb-3">
                        <label class="form-label text-muted small">Message</label>
                        <textarea class="form-control bg-dark text-light border-secondary p-3" rows="5" placeholder="Let's build something together..." style="border-radius: 12px; background: rgba(0,0,0,0.3) !important;"></textarea>
                    </div>
                    <button type="button" class="btn btn-primary btn-lg w-100 p-3 mt-2 d-flex align-items-center justify-content-center gap-2" style="border-radius: 12px;">
                        <i class="bi bi-send-fill"></i> Send Message
                    </button>
                </form>
            </div>
        </div>
    </div>
</div>
