@{
    ViewData["Title"] = "Home Page";
}

<div class="text-center hero-section py-5">
    <h1 class="display-3 fw-bold text-primary mb-3">Hi, I'm Keepon Mirishoi</h1>
    <p class="lead mb-4">Mobile App Developer | Entrepreneur | Software Engineer</p>
    <div class="d-flex justify-content-center gap-3">
        <a asp-controller="Home" asp-action="About" class="btn btn-primary btn-lg">More About Me</a>
        <a asp-controller="Home" asp-action="Contact" class="btn btn-outline-light btn-lg">Get in Touch</a>
    </div>
</div>

<div class="row mt-5">
    <div class="col-md-12 mb-5">
        <div class="card p-4">
            <h3 class="section-title">What I Do</h3>
            <div class="row g-4 mt-2">
                <div class="col-md-4">
                    <div class="d-flex align-items-start">
                        <div class="fs-2 text-primary me-3">📱</div>
                        <div>
                            <h5 class="fw-bold">Mobile App Development</h5>
                            <p class="text-muted">Specializing in Flutter, Design, Systems & Product Building.</p>
                        </div>
                    </div>
                </div>
                <div class="col-md-4">
                    <div class="d-flex align-items-start">
                        <div class="fs-2 text-primary me-3">🚀</div>
                        <div>
                            <h5 class="fw-bold">Business & Ventures</h5>
                            <p class="text-muted">Entrepreneurship (Amanah Logistics, Freewill™️ Clothing), Notion workspaces, and Product Marketing.</p>
                        </div>
                    </div>
                </div>
                <div class="col-md-4">
                    <div class="d-flex align-items-start">
                        <div class="fs-2 text-primary me-3">🎮</div>
                        <div>
                            <h5 class="fw-bold">Creative Design</h5>
                            <p class="text-muted">Game design (2D puzzle/adventure), World-building, and Graphic Design.</p>
                        </div>
                    </div>
                </div>
            </div>
        </div>
    </div>
</div>

<div class="row">
    <div class="col-md-6 mb-4">
        <div class="card h-100 p-4">
            <h3 class="section-title">Technical Skills</h3>
            <ul class="list-unstyled mt-3">
                <li class="mb-3 d-flex align-items-center">
                    <span class="badge bg-primary me-2">Flutter</span> 
                    Mobile development & Architecture
                </li>
                <li class="mb-3 d-flex align-items-center">
                    <span class="badge bg-primary me-2">Backend</span> 
                    Supabase Auth + Integration
                </li>
                <li class="mb-3 d-flex align-items-center">
                    <span class="badge bg-primary me-2">APIs</span> 
                    Google Cloud APIs, Places API
                </li>
                <li class="mb-3 d-flex align-items-center">
                    <span class="badge bg-primary me-2">Tools</span> 
                    Notion Automation, Template Building
                </li>
                <li class="mb-3 d-flex align-items-center">
                    <span class="badge bg-primary me-2">Graphics</span> 
                    Computer Graphics Fundamentals
                </li>
            </ul>
        </div>
    </div>
    <div class="col-md-6 mb-4">
        <div class="card h-100 p-4">
            <h3 class="section-title">Creative & Business</h3>
            <ul class="list-unstyled mt-3">
                <li class="mb-3">
                    <strong>Storytelling:</strong> Game storytelling, Character/World design, Brand identity.
                </li>
                <li class="mb-3">
                    <strong>Writing:</strong> Technical writing, Product storytelling, Copywriting.
                </li>
                <li class="mb-3">
                    <strong>Design:</strong> Brochure creation, Simple graphic design for small businesses.
                </li>
                <li class="mb-3">
                    <strong>Entrepreneurship:</strong> Product development, Marketing, Early-stage systems.
                </li>
            </ul>
        </div>
    </div>
</div>
