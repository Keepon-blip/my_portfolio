@{
    ViewData["Title"] = "Home Page";
}

<div class="container-fluid px-0 mb-5 fade-in-on-scroll home-hero">
    <div class="row min-vh-100 align-items-center">
        <div class="col-lg-7 mb-5 mb-lg-0">
            <div class="pe-lg-5">
                <h1 class="display-1 fw-bold text-white mb-4">
                    Software Engineer<br>
                    <span class="text-primary">& Startup Founder.</span>
                </h1>
                <p class="lead text-muted mb-3" style="max-width: 600px;">
                    Final-year Software Engineering student at <strong>Xiamen University Malaysia</strong>.
                </p>
                <p class="text-muted mb-3" style="max-width: 600px;">
                    Startup co-founder with hands-on experience building production-ready full-stack web applications,
                    Flutter mobile solutions, and immersive Unity XR applications.
                </p>
                <p class="text-muted mb-5" style="max-width: 600px;">
                    Interested in internship opportunities where software engineering can support education, digital
                    transformation, and sustainable development initiatives.
                </p>
                <div class="d-flex gap-3">
                    <a asp-controller="Home" asp-action="Projects"
                       class="btn btn-primary btn-lg d-flex align-items-center gap-2">
                        <i class="bi bi-briefcase-fill"></i> View Projects
                    </a>
                    <a asp-controller="Home" asp-action="Contact"
                       class="btn btn-outline-light btn-lg d-flex align-items-center gap-2">
                        <i class="bi bi-envelope-fill"></i> Get in Touch
                    </a>
                </div>
            </div>
        </div>
        <div class="col-lg-5">
            <div class="profile-frame mx-auto">
                <img src="~/images/profile.png" alt="Keepon Mirishoi Ole Supuko" class="img-fluid">
            </div>
        </div>
    </div>
</div>

<div class="row mt-5 pt-5 fade-in-on-scroll">
    <div class="col-12">
        <h3 class="section-title mb-5">What I Build</h3>
    </div>
    <div class="col-md-4 mb-4">
        <div class="card p-4 h-100">
            <div class="fs-1 text-primary mb-3"><i class="bi bi-cpu-fill"></i></div>
            <h4 class="fw-bold mb-3">Full Stack Development</h4>
            <p class="text-muted">Designing and developing scalable web systems, MVC frameworks, and APIs. Skilled in
                ASP.NET Core, Node.js, and containerized deployments.</p>
        </div>
    </div>
    <div class="col-md-4 mb-4">
        <div class="card p-4 h-100">
            <div class="fs-1 text-primary mb-3"><i class="bi bi-phone-fill"></i></div>
            <h4 class="fw-bold mb-3">Mobile & Cloud Systems</h4>
            <p class="text-muted">Building Flutter applications backed by Supabase and Firebase, with production
                deployment experience using AWS EC2, Docker, and Nginx.</p>
        </div>
    </div>
    <div class="col-md-4 mb-4">
        <div class="card p-4 h-100">
            <div class="fs-1 text-primary mb-3"><i class="bi bi-unity"></i></div>
            <h4 class="fw-bold mb-3">Unity & XR Development</h4>
            <p class="text-muted">Creating Android AR learning experiences with Unity, C#, AR Foundation, XR
                Interaction Toolkit, Gemini AI, and voice interaction.</p>
        </div>
    </div>
</div>
