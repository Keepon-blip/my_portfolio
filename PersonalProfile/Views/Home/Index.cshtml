@{
    ViewData["Title"] = "Home Page";
}

<div class="container-fluid px-0">
    <div class="row min-vh-100 align-items-center">
        <div class="col-lg-6 mb-5 mb-lg-0">
            <div class="pe-lg-5">
                <h1 class="display-1 fw-bold text-white mb-4">
                    Designer<br>
                    <span class="text-primary">& Dev.</span>
                </h1>
                <p class="lead text-muted mb-5" style="max-width: 500px;">
                    A selection of websites, applications and graphic design projects. Made with happy clients, agencies and collaborators from around the globe.
                </p>
                <div class="d-flex gap-3">
                    <a asp-controller="Home" asp-action="Projects" class="btn btn-primary btn-lg">View Projects</a>
                    <a asp-controller="Home" asp-action="Contact" class="btn btn-outline-light btn-lg">Get in Touch</a>
                </div>
            </div>
        </div>
        <div class="col-lg-6">
            <div class="profile-frame">
                <img src="~/images/profile.jpg" alt="Keepon Mirishoi" class="img-fluid">
            </div>
        </div>
    </div>
</div>

<div class="row mt-5 pt-5">
    <div class="col-12">
        <h3 class="section-title mb-5">What I Do</h3>
    </div>
    <div class="col-md-4 mb-4">
        <div class="card p-4 h-100">
            <div class="fs-1 text-primary mb-3">📱</div>
            <h4 class="fw-bold mb-3">Mobile App Development</h4>
            <p class="text-muted">Specializing in Flutter, Design, Systems & Product Building. Creating seamless mobile experiences.</p>
        </div>
    </div>
    <div class="col-md-4 mb-4">
        <div class="card p-4 h-100">
            <div class="fs-1 text-primary mb-3">🚀</div>
            <h4 class="fw-bold mb-3">Business & Ventures</h4>
            <p class="text-muted">Entrepreneurship (Amanah Logistics, Freewill™️ Clothing), Notion workspaces, and Product Marketing.</p>
        </div>
    </div>
    <div class="col-md-4 mb-4">
        <div class="card p-4 h-100">
            <div class="fs-1 text-primary mb-3">🎮</div>
            <h4 class="fw-bold mb-3">Creative Design</h4>
            <p class="text-muted">Game design (2D puzzle/adventure), World-building, and Graphic Design. Bringing imagination to life.</p>
        </div>
    </div>
</div>
